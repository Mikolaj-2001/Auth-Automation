generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  userName      String  @unique
  Surname       String
  email         String  @unique
  password      String  @unique
  userRefID     String  @unique
  encryptionKey String?

  dataAuthById  DataAuth? @relation("DataAuthByUserId")
  dataAuthByRef DataAuth? @relation("DataAuthByUserRefID")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model DataAuth {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique @db.ObjectId
  user          User      @relation("DataAuthByUserId", fields: [userId], references: [id])
  userByRef     User      @relation("DataAuthByUserRefID", fields: [userRefID], references: [userRefID])
  userAuthID    Float     @unique
  Name          String
  email         String    @unique
  userRefID     String    @unique
  encryptionKey String
  knownIpHashes String[]  @default([])
  lastLoginIp   String?
  lastLoginDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dataauths")
}
