{{> headers}}

<div class="modern-page-wrapper">
    {{#if error}}
    <div class="modern-error-alert alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i> {{error}}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {{/if}}

    <div class="modern-navbar navbar-modern">
        <div class="navbar-container">
            <div class="navbar-brand-modern">
                <h2 class="mb-0"><i class="bi bi-shield-lock"></i> User Dashboard</h2>
            </div>
            <div class="navbar-actions">
                <form action="/user/logout" method="post" class="navbar-form">
                    <button class="btn btn-modern btn-outline-success-modern" type="submit">
                        <i class="bi bi-box-arrow-right"></i> Log Out
                    </button>
                </form>
                <form action="/auth/user/AuthTemplateCongregate/{{user.userRefID}}" method="get" class="navbar-form">
                    <button class="btn btn-modern btn-secondary-modern" type="submit">
                        <i class="bi bi-person-circle"></i> My Profile
                    </button>
                </form>
                <form action="/user/register" method="get" class="navbar-form">
                    <button class="btn btn-modern btn-secondary-modern" type="submit">
                        <i class="bi bi-person-plus"></i> Register Another
                    </button>
                </form>
                <form action="/user/delete/{{user._id}}" method="post" 
                    onsubmit="return confirm('⚠️ Are you sure? This action is permanent and cannot be undone!');" 
                    class="navbar-form">
                    <button class="btn btn-modern btn-danger-modern" type="submit">
                        <i class="bi bi-trash-fill"></i> Delete Account
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="user-details-card modern-card">
        <div class="card-header-modern">
            <h3><i class="bi bi-person-vcard-fill"></i> Account Information</h3>
        </div>
        <div class="card-body-modern">
            <div class="user-info-grid">
                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-person-fill field-icon"></i>
                        <span class="field-label">Username</span>
                    </div>
                    <div class="field-value-modern">{{user.userName}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-envelope-fill field-icon"></i>
                        <span class="field-label">Email Address</span>
                    </div>
                    <div class="field-value-modern">{{user.email}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-key-fill field-icon"></i>
                        <span class="field-label">User ID</span>
                    </div>
                    <div class="field-value-modern user-id-monospace">{{user._id}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-link-45deg field-icon"></i>
                        <span class="field-label">User Reference ID</span>
                    </div>
                    <div class="field-value-modern user-id-monospace">{{user.userRefID}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-shield-check field-icon"></i>
                        <span class="field-label">Auth ID</span>
                    </div>
                    <div class="field-value-modern user-id-monospace">{{user.userAuthID}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-shield-lock field-icon"></i>
                        <span class="field-label">IP Hash</span>
                    </div>
                    <div class="field-value-modern user-id-monospace">{{ipInfo.ipHash}}</div>
                </div>

                <div class="user-field-modern">
                    <div class="field-icon-label">
                        <i class="bi bi-globe-fill field-icon"></i>
                        <span class="field-label">Last Login IP</span>
                    </div>
                    <div class="field-value-modern">{{ipInfo.lastLoginIp}}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="modern-footer">
    <p><i class="bi bi-shield-check"></i> &copy; 2026 Auth Automation. All rights reserved to the author: Mikołaj Gafiuk</p>
</footer>