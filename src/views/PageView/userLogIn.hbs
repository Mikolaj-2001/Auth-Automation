{{> headers}}

<div class="modern-page-wrapper">
    <div class="modern-form-container auth-form-card">
        <div class="modern-form-header">
            <h1 class="modern-page-title"><i class="bi bi-lock-fill"></i> User Log-in</h1>
        </div>

        {{#if error}}
        <div class="modern-error-alert alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> {{error}}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {{/if}}

        <form method="POST" action="/user/login" id="loginForm" class="modern-form">
            <div class="form-group-modern">
                <label for="userAuthID" class="form-label-modern">
                    <i class="bi bi-person-id-card"></i> User Auth ID
                </label>
                <input type="text" name="userAuthID" id="userAuthID" class="form-control form-control-modern" 
                    value="{{user.userAuthID}}" required placeholder="Enter your Auth ID">
            </div>

            <div class="form-group-modern">
                <label for="email" class="form-label-modern">
                    <i class="bi bi-envelope-fill"></i> Email Address
                </label>
                <input type="email" name="email" id="email" class="form-control form-control-modern" 
                    value="{{user.email}}" required placeholder="Enter your email">
            </div>

            <div class="form-group-modern">
                <label for="userName" class="form-label-modern">
                    <i class="bi bi-person-fill"></i> Username
                </label>
                <input type="text" name="userName" id="userName" class="form-control form-control-modern" 
                    value="{{user.userName}}" required placeholder="Enter your username">
            </div>

            <div class="form-group-modern">
                <label for="password" class="form-label-modern">
                    <i class="bi bi-key-fill"></i> Password
                </label>
                <input type="password" name="password" id="password" class="form-control form-control-modern" 
                    required placeholder="Enter your password">
                {{#if error}}
                <small class="form-text-error">
                    <i class="bi bi-info-circle"></i> Incorrect password. Please try again.
                </small>
                {{/if}}
            </div>

            <button type="submit" class="btn btn-modern btn-primary-modern w-100" id="loginButton">
                <i class="bi bi-box-arrow-in-right"></i> Log In
            </button>
        </form>

        <div class="modern-form-footer">
            <p class="text-center mb-2">Don't have an account?</p>
            <a href="/user/register" class="btn btn-outline-modern w-100">
                <i class="bi bi-person-plus-fill"></i> Create New Account
            </a>
        </div>
    </div>
</div>

<footer class="modern-footer">
    <p><i class="bi bi-shield-check"></i> &copy; 2026 Auth Automation. All rights reserved to the author: Mikołaj Gafiuk</p>
</footer>