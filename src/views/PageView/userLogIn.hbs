{{> headers}}

<h1>User log-in View</h1>

{{#if error}}
<div class="error-message">
    {{message}}
</div>
{{/if}}

<form method="POST" action="/login" id="loginForm">
    <div class="row g-3 align-items-center" id="emailField" style="margin-bottom: 10px;">
        <div class="col-auto" style="margin-bottom: 4px;">
            <label for="userName" class="userName-input-label"
                style="text-align: center; vertical-align: middle; width: 100%; display: inline-block;">Provide
                email</label>
            <input type="email" name="email" id="email" class="form-control" value="{{user.email}}" required
                style="margin-top: 2px;">
        </div>
        <div class="col-auto" style="margin-bottom: 4px;">
            <label for="email" class="email-input-label"
                style="text-align: center; vertical-align: middle; width: 100%; display: inline-block;">Provide user
                name</label>
            <input type="text" name="userName" id="userName" class="form-control" value="{{user.userName}}" required
                style="margin-top: 2px;">
        </div>
    </div>
    <div class="row g-3 align-items-center" id="passwordField" style="margin-bottom: 10px;">
        <div class="col-auto" style="margin-bottom: 4px;">
            <label for="password" class="password-input-label"
                style="text-align: center; vertical-align: middle; width: 100%; display: inline-block;">Provide
                password</label>
            <input type="password" name="password" id="password" class="form-control" required style="margin-top: 2px;">
        </div>
        {{#if error}}
        <div class="col-auto" id="passwordError">
            <span id="passwordHelpInline" class="form-text">
                Incorrect password was provided.Try again !!
            </span>
        </div>
        {{/if}}
        <div class="col-auto" id="submitButton" style="margin-bottom: 8px;">
            <button type="submit" class="btn btn-primary" id="registerButton" style="margin-bottom: 0;">Log in</button>
        </div>
        <br>
        <div class="col-12 text-center" id="loginLink" style="margin-top: 0;">
            <p id="loginLinkText" style="margin-top: 0;">If you don't have an account, <a href="/user/register"
                    class="btn btn-link" id="innerButton2">Log-in</a></p>
        </div>
    </div>
</form>
<br>
